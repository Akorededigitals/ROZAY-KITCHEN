# =========================================================
# Netlify & Production Environment Variables Configuration
# =========================================================
# All variables prefixed with VITE_ are exposed to the client-side bundle.
# In Netlify: Go to Site settings > Environment variables and add these keys.

# 1. Supabase Project Credentials (REQUIRED for live database & Supabase Storage)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# 2. Paystack Payment Gateway Integration (Optional)
VITE_PAYSTACK_PUBLIC_KEY="pk_live_or_test_key"

# 3. Gemini AI Assistant (Server-side / Runtime Secret)
GEMINI_API_KEY=""

# 4. WhatsApp & Contact Configuration
# Standard Nigerian international format without '+' or spaces (e.g. 2348123221174 or 08123221174)
VITE_WHATSAPP_NUMBER="2348123221174"
VITE_CONTACT_PHONE="+234 812 322 1174"

# 5. Live Site URL (Used for product links & order tracking in WhatsApp messages)
VITE_SITE_URL="https://your-site-name.netlify.app"
APP_URL="https://your-site-name.netlify.app"
