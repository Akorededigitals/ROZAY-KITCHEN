# ====================================================================
# Rozay Kitchen - Production Environment Variables Configuration
# Works with Truehost (cPanel / Node.js), Netlify, Vercel & Cloud Run
# ====================================================================
# All variables prefixed with VITE_ are compiled into the client-side bundle.

# --------------------------------------------------------------------
# 1. Supabase Project Credentials (REQUIRED for database & image storage)
# --------------------------------------------------------------------
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# --------------------------------------------------------------------
# 2. Paystack Payment Gateway Integration (Optional for Online Checkout)
# --------------------------------------------------------------------
VITE_PAYSTACK_PUBLIC_KEY="pk_live_xxxxxxxxxxxxxxxxxxxxxxxx"

# --------------------------------------------------------------------
# 3. Gemini AI Assistant (Server-side Secret - Optional)
# --------------------------------------------------------------------
GEMINI_API_KEY=""

# --------------------------------------------------------------------
# 4. WhatsApp & Contact Numbers (Nigerian Format)
# --------------------------------------------------------------------
# Standard Nigerian format without '+' or spaces (e.g. 2348123221174)
VITE_WHATSAPP_NUMBER="2348123221174"
VITE_CONTACT_PHONE="+234 812 322 1174"

# --------------------------------------------------------------------
# 5. Live Website Domain URL (e.g. https://rozaykitchen.com)
# --------------------------------------------------------------------
# Used for generating product links & order tracking URLs in WhatsApp messages
VITE_SITE_URL="https://rozaykitchen.com"
APP_URL="https://rozaykitchen.com"

# --------------------------------------------------------------------
# 6. Server Port (Used by Truehost Node.js App or VPS)
# --------------------------------------------------------------------
PORT=3000
